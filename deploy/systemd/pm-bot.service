[Unit]
Description=Prediction market: Telegram bot (long polling)
Requires=pm-db.service
After=pm-db.service network-online.target

[Service]
User=pm
Group=pm
WorkingDirectory=/opt/prediction_market/app
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/prediction_market/venv/bin/python manage.py run_telegram_bot
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
