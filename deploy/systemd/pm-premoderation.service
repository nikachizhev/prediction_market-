[Unit]
Description=Prediction market: publication moderation
Requires=pm-db.service
After=pm-db.service network-online.target

[Service]
User=pm
Group=pm
WorkingDirectory=/opt/prediction_market/app
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/prediction_market/venv/bin/python manage.py run_premoderation
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
