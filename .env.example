DJANGO_DEBUG=1
DJANGO_SECRET_KEY=local-development-key-change-before-deployment
SITE_URL=http://127.0.0.1:8000

POSTGRES_DB=prediction_market
POSTGRES_USER=prediction_market
POSTGRES_PASSWORD=local-development-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Team dashboard in Metabase: password of the read-only role metabase_ro
# (manage.py setup_metabase_role) and the local port of the Metabase web UI.
METABASE_DB_PASSWORD=
METABASE_PORT=3000

# Prints verification emails to the terminal for local development.
# To send real emails, set django.core.mail.backends.smtp.EmailBackend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.mail.ru
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_USE_TLS=0
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Short name of the Mini App registered in BotFather (t.me/<bot>/<app>).
TELEGRAM_APP_NAME=app
# Separate BotFather bot. Never reuse TELEGRAM_BOT_TOKEN. Telegram numeric user IDs, not @names.
MODERATION_BOT_TOKEN=
MODERATION_ADMIN_IDS=
GITHUB_TOKEN=

# AI rules helper in the market creation wizard (spec E9.1). Any OpenAI-compatible API;
# empty key or ASSIST_ENABLED=0 turns the helper off, the wizard works without it.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash
ASSIST_ENABLED=1
